{
  "name": "dsh-calendar",
  "version": "0.14.1",
  "description": "DSH 日历工作台：CalDAV 日程、月 / 周 / 议程视图、空闲时段建议与 ICS 预览导入。欢迎提交 issues 和 PR。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-updates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "calendar",
    "caldav",
    "ical",
    "availability"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3",
    "ical.js": "^2.1.0",
    "schemastery": "^3.18.0",
    "timezones-ical-library": "2.3.2",
    "tsdav": "^2.3.1",
    "undici": "^8.11.2",
    "yaml": "^2.9.1",
    "@stardustlc/dsh-updates": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-calendar.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-calendar/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-calendar#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0"
}
